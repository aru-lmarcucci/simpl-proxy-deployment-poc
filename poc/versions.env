# Pinned versions for the PoC. Latest stable releases as of 2026-11-16.
# Never use "latest". Sourced by poc/lib.sh.

# kind CLI and node image (image digest from the kind release notes).
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed

# OpenBao: Helm chart (repo https://openbao.github.io/openbao-helm) and server image.
OPENBAO_CHART_VERSION=0.30.7
OPENBAO_IMAGE_TAG=2.7.2

# Bank-Vaults vault-secrets-webhook (OCI chart oci://ghcr.io/bank-vaults/helm-charts/vault-secrets-webhook).
VAULT_WEBHOOK_CHART_VERSION=1.23.1

# Argo CD: install manifest and CLI.
ARGOCD_VERSION=v3.6.1

# ChartMuseum: Helm chart (repo https://chartmuseum.github.io/charts) and image.
CHARTMUSEUM_CHART_VERSION=3.10.4
CHARTMUSEUM_IMAGE_TAG=v0.16.6

# Base images for the stub and the provisioning job.
PYTHON_IMAGE=python:3.12.16-slim-trixie
ALPINE_IMAGE=alpine:3.24.4

# Lint for bash scripts (run via Docker when shellcheck is not installed).
SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0
